{
  "cli": {
    "name": "Superopen CLI",
    "display_name": "CLI",
    "release_name": "cli",
    "tag_prefix": "cli-",
    "paths": [
      "cmd/**",
      "internal/**",
      "sdk/**",
      "plugins/**",
      "scripts/**",
      "web/**",
      ".claude-plugin/**",
      "go.mod",
      "go.sum",
      "Makefile",
      "VERSION"
    ],
    "version_strategy": "version-file",
    "working_directory": ".",
    "version_files": ["VERSION", "internal/version/version.go"],
    "publisher": "cli"
  }
}
