{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "so coding hook --vendor=cc --event=SessionStart",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "so graph refresh --detach",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "so coding hook --vendor=cc --event=UserPromptSubmit",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "so coding hook --vendor=cc --event=PreToolUse --kind=search",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "so coding hook --vendor=cc --event=PreToolUse --kind=read",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "so coding hook --vendor=cc --event=PostToolUse",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "so coding hook --vendor=cc --event=Stop",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "so graph refresh --detach",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "so coding hook --vendor=cc --event=SubagentStart",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "so coding hook --vendor=cc --event=SubagentStop",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "so coding hook --vendor=cc --event=SessionEnd",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "so sessions finalize --detach",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "so graph refresh --detach",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
